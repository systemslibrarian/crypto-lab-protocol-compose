{
  "name": "crypto-lab-protocol-compose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc -b && vite build",
    "preview": "vite preview",
